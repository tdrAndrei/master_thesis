\ProvidesPackage{document}

% Preamble for the acmart version, compiled with XeLaTeX.
%
% acmart already loads and configures: fonts (Libertine, Libertinus Math via
% unicode-math, Inconsolata), amsmath, amsthm, graphicx, xcolor, hyperref,
% microtype, booktabs and caption.  Do not load those again here, and do not
% load amssymb or mathabx: they clash with unicode-math.

\RequireXeTeX{}

% Characters missing from acmart's fonts (XeTeX has no automatic font
% fallback; missing glyphs are dropped with only a log message).
% Inconsolata, the monospace font, has no U+2200.
\usepackage{newunicodechar}
\newunicodechar{∀}{\ensuremath{\forall}}


% Figures and inference rules
\usepackage{circuitikz}         % scope-graph diagrams
\usepackage{mathpartir}         % \inferrule, mathpar
\usepackage{framed}


% Notation
\def\betared{\Rightarrow_{\beta}}


% Bibliography (ACM's own biblatex style, shipped with acmart)
\usepackage[
  backend=biber,
  datamodel=acmdatamodel,
  style=acmnumeric
]{biblatex}
% Entries with a DOI do not need ISSN or URL.
\AtEveryBibitem{%
  \iffieldundef{doi}
  {}
  {%
    \clearfield{issn}%
    \clearfield{url}%
    \clearfield{urldate}%
  }%
}


% Listings
\usepackage{listings}

\lstdefinestyle{centered}{
  basicstyle=\ttfamily\small,
  breaklines=true,
  frame=single
}
\lstset{style=centered}

\lstdefinestyle{hoas}{
  basicstyle=\ttfamily\small,
  columns=fullflexible,
  keepspaces=true,
  frame=single,
  breaklines=true,
  showstringspaces=false
}

\lstdefinelanguage{SDF3}{
  keywords={Name, Number, module, imports, context-free, lexical, syntax, start-symbols},
  sensitive=true,
  morecomment=[l]{//},
  morecomment=[s]{/*}{*/},
  morestring=[b]"
}

\lstdefinelanguage{Rust}{
  keywords={fn, let, mut, pub, impl, trait, struct, enum, match, if, else, loop, while, for, in, return, break, continue, use, mod, crate, super, self, Self, const, static, ref, type, where, as},
  keywordstyle=\color{blue}\bfseries,
  ndkeywords={i32, i64, u32, u64, f32, f64, usize, isize, bool, String, str},
  ndkeywordstyle=\color{teal},
  identifierstyle=\color{black},
  sensitive=true,
  comment=[l]{//},
  morecomment=[s]{/*}{*/},
  commentstyle=\color{gray}\ttfamily,
  stringstyle=\color{orange},
  morestring=[b]",
}


% Cross-references: \cref{} mid-sentence, \Cref{} at the start of a sentence.
% Load last: cleveref must come after listings to name listings correctly.
\usepackage[capitalise, noabbrev]{cleveref}

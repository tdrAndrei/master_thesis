% Notation
\def\betared{\Rightarrow_{\beta}}


% Bibliography (ACM's own biblatex style, shipped with acmart)
\usepackage[
  backend=biber,
  datamodel=acmdatamodel,
  style=acmnumeric
]{biblatex}
% Entries with a DOI do not need ISSN or URL.
\AtEveryBibitem{%
  \iffieldundef{doi}
  {}
  {%
    \clearfield{issn}%
    \clearfield{url}%
    \clearfield{urldate}%
  }%
}


% Listings: one style for all code in the paper (ACM PL look: small mono,
% bold keywords, gray comments, gray line numbers, short rule above,
% full rule below, caption below).
\usepackage{listings}

\lstset{
  basicstyle=\ttfamily\small,
  columns=fullflexible,
  keepspaces=true,
  keywordstyle=\bfseries,
  commentstyle=\color{gray},          % Inconsolata has no italic
  stringstyle=\color{black},
  showstringspaces=false,
  frame=b,                             % top rule: see \lsttoprulewidth below
  framesep=4pt,
  aboveskip=0pt,
  belowskip=\medskipamount,
  captionpos=b,
  breaklines=true,
  numbers=left,                        % line numbers, inside the text block:
  numberstyle=\scriptsize\color{gray},
  numbersep=8pt,
  xleftmargin=1.5em,                   % code indented to make room for them,
  framexleftmargin=1.5em,              % bottom rule still starts at the margin
}
% Mark wrapped lines in displayed listings only, not in inline \lstinline code.
\AddToHook{env/lstlisting/begin}{%
  \lstset{postbreak=\mbox{\textcolor{gray}{$\hookrightarrow$}\space}}}

% listings can only draw full-width frame rules, so the top rule is drawn
% here instead, before each lstlisting environment, at a shorter width.
% \lsttoprulewidth is a fraction of the line width (1 = full width).
\newcommand{\lsttoprulewidth}{0.5}
\AddToHook{env/lstlisting/before}{%
  \par\addvspace{\medskipamount}%
  \hrule width \lsttoprulewidth\linewidth height \fboxrule\relax
  \nopagebreak\kern4pt\nopagebreak}

% The dependently typed object language of this paper (the default).
\lstdefinelanguage{Core}{
  morekeywords={let, def, postulate, module, open, Set, refl},
  sensitive=true,
  morecomment=[l]{--},
}

% Statix specifications (Spoofax).
\lstdefinelanguage{Statix}{
  morekeywords={module, imports, signature, sorts, constructors, relations,
    rules, name-resolution, labels, resolve, query, filter, min, and, new,
    true, false, try, scope, in, string, int, list, occurrence},
  sensitive=true,
  morecomment=[l]{//},
  morecomment=[s]{/*}{*/},
  morestring=[b]",
}

% Elpi (lambda Prolog).
\lstdefinelanguage{Elpi}{
  morekeywords={kind, type, pred, pi, sigma, i, o},
  otherkeywords={:-, =>, ==>},
  sensitive=true,
  morecomment=[l]{\%},
  morestring=[b]",
}

% SDF3 syntax definitions (Spoofax).
\lstdefinelanguage{SDF3}{
  morekeywords={module, imports, context-free, lexical, syntax, start-symbols,
    sorts, left, right},
  sensitive=true,
  morecomment=[l]{//},
  morecomment=[s]{/*}{*/},
  morestring=[b]",
}

\lstdefinelanguage{Agda}{
  morekeywords={data, where, record, field, module, open, import, Set},
  sensitive=true,
  morecomment=[l]{--},
}

\lstdefinelanguage{Rust}{
  morekeywords={fn, let, mut, pub, impl, trait, struct, enum, match, if, else,
    loop, while, for, in, return, break, continue, use, mod, crate, super,
    self, Self, const, static, ref, type, where, as},
  sensitive=true,
  morecomment=[l]{//},
  morecomment=[s]{/*}{*/},
  morestring=[b]",
}

% Code without a language option is in the object language.
\lstset{language=Core}


